{
  "name": "xiong-shifu-workbench",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n client,server -c #c9a961,#6b7d4f \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "npm --prefix server run dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "npm --prefix server run start",
    "gen:icons": "node scripts/gen-icons.mjs",
    "install:all": "npm install && npm --prefix server install"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.5.2",
    "axios": "^1.7.2",
    "dompurify": "^3.1.6",
    "echarts": "^5.5.1",
    "marked": "^13.0.2",
    "vue": "^3.4.31",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.5",
    "concurrently": "^8.2.2",
    "vite": "^5.3.3",
    "vite-plugin-pwa": "^1.3.0"
  }
}
